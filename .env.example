# Required: Gemini API Key for real-time voice-to-voice and live interactions
GEMINI_API_KEY=

# Optional: Separate Gemini API key for background agent workloads (falls back to GEMINI_API_KEY)
GEMINI_API_KEY_AGENTS=

# Optional: Anthropic API key for specialized Claude coding pipeline
ANTHROPIC_API_KEY=

# Optional: YouTube Data API v3 key for real YouTube trending data grounding
YOUTUBE_API_KEY=
